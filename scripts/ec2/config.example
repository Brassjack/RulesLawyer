# Copy to /etc/rules-lawyer-bot/config (install script does this).
# Full image reference including tag (ECR or any registry).

IMAGE_URI=123456789012.dkr.ecr.us-east-1.amazonaws.com/rules-lawyer-bot:latest

# Optional: log in to ECR before run (needs aws CLI + instance profile or credentials).
# ECR_LOGIN=true
# AWS_REGION=us-east-1

# Optional: docker pull before every start (useful after you push a new tag).
# PULL_BEFORE_RUN=true
