[Unit]
Description=Rules Lawyer Discord bot (Docker container)
Documentation=file:///usr/local/share/doc/rules-lawyer-bot/ec2-service.txt
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5

# Remove stale container name from a previous crash before starting.
ExecStartPre=-/usr/bin/docker rm -f rules-lawyer-bot

ExecStart=/usr/local/bin/rules-lawyer-bot-docker-run
ExecStop=-/usr/bin/docker stop -t 30 rules-lawyer-bot
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
